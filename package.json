  "description": "OS-level sandbox for Pi's bash tool, with path guards for its file tools.",
  "license": "MIT",
  "author": "ahalekelly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahalekelly/pi-sandbox.git"
